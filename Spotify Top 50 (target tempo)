#Finding the average tempo of artists who have appeared in the top 50 the most

SELECT avg(tempo)
FROM (
SELECT artist_name, COUNT(track_name) AS Appearances, tempo
FROM BIT_DB.Spotifydata
GROUP BY artist_name
HAVING Appearances > 1
ORDER BY Appearances desc)
;

avg(tempo) = 137.5

