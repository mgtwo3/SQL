# Next I wanted to see if there is a correlation with tempo and the popularity of a song 
# First I want to know what the average popularity is

SELECT avg(popularity)
FROM BIT_DB.Spotifydata;

avg(popularity) = 86.75

# Checking for tempo with songs greater than the average popularity

SELECT avg(tempo)
FROM BIT_DB.Spotifydata
WHERE popularity > 86.75;

avg(tempo) = 125.5

# Checking for tempo with songs less than the average popularity

SELECT avg(tempo)
FROM BIT_DB.Spotifydata
WHERE popularity < 86.75;

avg(tempo) = 113.4

# There is correlation with higher tempo songs being more popular to listeners
#Checking tempo of songs with popularity greater than 90

SELECT avg(tempo)
FROM BIT_DB.Spotifydata
WHERE popularity > 90;

avg(tempo) = 138.8

# Which artists have the most songs in the top 50 

SELECT artist_name, COUNT(track_name) AS Appearances, tempo
FROM BIT_DB.Spotifydata
GROUP BY artist_name
HAVING Appearances > 1
ORDER BY Appearances desc
;

